# Copia este archivo como .env y completa los valores.
# En Vercel: Project Settings > Environment Variables.

# Clave larga y aleatoria para firmar la sesión.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Clave SECRETA de Supabase (Project Settings > API Keys > Secret keys).
# Solo para el servidor: permite registrar empresas y leer sus datos.
SUPABASE_SERVICE_KEY=

# Pon 1 para recarga automática al desarrollar en tu computador
FLASK_DEBUG=1

# Asistente IA: usa UNA de estas dos opciones.
# Opción gratis: clave de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Opción pagada: clave de OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
