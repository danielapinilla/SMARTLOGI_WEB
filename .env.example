# Copia este archivo como .env y completa los valores.
# En Vercel: Project Settings > Environment Variables.

# Clave larga y aleatoria para firmar la sesión.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Correos con acceso al panel, separados por coma (opcional pero recomendado)
ADMIN_EMAILS=admin@smartlogic.cl

# Pon 1 para recarga automática al desarrollar en tu computador
FLASK_DEBUG=1
